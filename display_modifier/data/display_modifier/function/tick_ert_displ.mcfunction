execute as @e[type=item_frame] if entity @s[nbt={Item:{components:{"minecraft:custom_data":{"datapack":"Display Modifier","action":2}}}}] unless block ~ ~ ~ redstone_wire[power=0] if block ~ ~ ~ redstone_wire run function display_modifier:modify_item_data/upload_lore
